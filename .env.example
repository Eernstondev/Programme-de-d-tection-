# Copie ce fichier en .env et remplis les valeurs. Ne le partage jamais.

# Telegram : token donné par @BotFather, chat_id obtenu via getUpdates (voir README)
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=

# Caméras (si le mot de passe contient @ : # / ? encode-le : @ -> %40, # -> %23, : -> %3A)
CAM_COUR_USER=admin
CAM_COUR_PASS=

# Supabase (si enabled: true)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_EMAIL=
SUPABASE_PASSWORD=
